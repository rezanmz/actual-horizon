# Copy to .env and fill in. Placeholders only — never commit real values.
# Generic onboarding: no personal data, secrets, or real budget exports in git.

# Server
PORT=3000
AUTH_MODE=disabled # disabled (local dev only) | oidc

# OIDC (required when AUTH_MODE=oidc)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
SESSION_SECRET=

# Actual Budget sidecar (server-side only — never exposed to the web app)
ACTUAL_SERVER_URL=
ACTUAL_PASSWORD=
ACTUAL_BUDGET_ID=
# ACTUAL_BUDGET_SYNC_ID=  # alternative to ACTUAL_BUDGET_ID
ACTUAL_DATA_DIR=./data
